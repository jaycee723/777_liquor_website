{
  "name": "777-liquor-website-cloudflare",
  "private": true,
  "workspaces": [
    "777-Liquor-Website/website",
    "777-Liquor-Website/website/packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=tanstack_start_ts",
