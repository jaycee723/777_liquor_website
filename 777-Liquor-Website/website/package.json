{
  "name": "tanstack_start_ts",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite dev --host 0.0.0.0 --port 3000",
    "build": "tsc --noEmit && vite build",
    "build:dev": "vite build --mode development",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "typecheck:packages": "for dir in packages/*; do if [ -f \"$dir/package.json\" ]; then (cd \"$dir\" && npm run typecheck); fi; done",
    "test:packages": "for dir in packages/*; do if [ -f \"$dir/package.json\" ]; then (cd \"$dir\" && npm run test); fi; done"
  },
  "dependencies": {
    "@higgsfield/fnf": "*",
    "@higgsfield/fnf-react": "*",
    "@higgsfield/quanta": "*",
    "@material-symbols/svg-400": "^0.45.5",
    "@stylexjs/stylex": "^0.18.3",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-query": "^5.83.0",
    "@tanstack/react-router": "^1.168.25",
    "@tanstack/react-start": "^1.167.50",
    "@tanstack/router-plugin": "^1.167.28",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.2.1",
    "vite-tsconfig-paths": "^6.0.2",
    "zod": "^4.0.0",
    "@base-ui/react": "1.5.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260615.1",
    "@eslint/js": "^9.32.0",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "nitro": "3.0.260429-beta",
    "prettier": "^3.7.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^7.3.1",
    "vite-plugin-svgr": "^5.2.0"
  },
  "overrides": {
    "@types/react": "19.2.15"
  }
}
